// MODULE VLNV: amd.com:blockdesign:design_1:1.0

// The following must be inserted into your System Verilog file for this
// module to be instantiated. Change the instance name, port and interface connections
// (in parentheses) to your own signal names.

// IMPORTANT: Please check the generated 'design_1_sv.sv' wrapper file is also included in the project.
//            This file can be found in the .gen folder of the respective IP or Block Design after
//            running the generate output products step.

// INCLUDE_TAG     ------ Begin cut for INTERFACE INSTANTIATION Include ------
`include "vivado_interfaces.svh"
// INCLUDE_TAG_END ------  End cut for INTERFACE INSTANTIATION Include  ------

// INTF_TAG     ------ Begin cut for INTERFACE INSTANTIATION Template ------

// INTF_TAG_END ------  End cut for INTERFACE INSTANTIATION Template  ------

// INST_TAG     ------ Begin cut for WRAPPER INSTANTIATION Template ------
design_1_sv your_instance_name (
  .ddr2_sdram_dq(ddr2_sdram_dq), // inout wire [15:0] ddr2_sdram_dq
  .ddr2_sdram_dqs_p(ddr2_sdram_dqs_p), // inout wire [1:0] ddr2_sdram_dqs_p
  .ddr2_sdram_dqs_n(ddr2_sdram_dqs_n), // inout wire [1:0] ddr2_sdram_dqs_n
  .ddr2_sdram_addr(ddr2_sdram_addr), // output wire [12:0] ddr2_sdram_addr
  .ddr2_sdram_ba(ddr2_sdram_ba), // output wire [2:0] ddr2_sdram_ba
  .ddr2_sdram_ras_n(ddr2_sdram_ras_n), // output wire ddr2_sdram_ras_n
  .ddr2_sdram_cas_n(ddr2_sdram_cas_n), // output wire ddr2_sdram_cas_n
  .ddr2_sdram_we_n(ddr2_sdram_we_n), // output wire ddr2_sdram_we_n
  .ddr2_sdram_ck_p(ddr2_sdram_ck_p), // output wire [0:0] ddr2_sdram_ck_p
  .ddr2_sdram_ck_n(ddr2_sdram_ck_n), // output wire [0:0] ddr2_sdram_ck_n
  .ddr2_sdram_cke(ddr2_sdram_cke), // output wire [0:0] ddr2_sdram_cke
  .ddr2_sdram_cs_n(ddr2_sdram_cs_n), // output wire [0:0] ddr2_sdram_cs_n
  .ddr2_sdram_dm(ddr2_sdram_dm), // output wire [1:0] ddr2_sdram_dm
  .ddr2_sdram_odt(ddr2_sdram_odt), // output wire [0:0] ddr2_sdram_odt
  .usb_uart_rxd(usb_uart_rxd), // input wire usb_uart_rxd
  .usb_uart_txd(usb_uart_txd), // output wire usb_uart_txd
  .led_16bits_tri_o(led_16bits_tri_o), // output wire [15:0] led_16bits_tri_o
  .dip_switches_16bits_0_tri_i(dip_switches_16bits_0_tri_i), // input wire [15:0] dip_switches_16bits_0_tri_i
  .ck_a0(ck_a0), // output wire [3:0] ck_a0
  .reset(reset), // input wire reset
  .ck_b0(ck_b0), // input wire [3:0] ck_b0
  .clk_100MHz(clk_100MHz) // input wire clk_100MHz
);
// INST_TAG_END ------  End cut for WRAPPER INSTANTIATION Template  ------


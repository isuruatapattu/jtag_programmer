# Copy to sim/env.sh and edit. sim/run.sh sources it before every step.
# Only the tools for the simulator you run need to be on PATH.

# Questa: vlog, vsim, vcover
# module load questasim/2024.1
# export PATH=/opt/mentor/questasim/bin:$PATH

# VCS: vcs, urg
# module load vcs/V-2023.12
# export VCS_HOME=/opt/synopsys/vcs
# export PATH=$VCS_HOME/bin:$PATH

# Licenses, if not set by the modules
# export LM_LICENSE_FILE=port@licserver
# export SNPSLMD_LICENSE_FILE=port@licserver

# Optional: tclsh for scripts/summarize.tcl. Without it, Questa's vsim is used
# for the summary, and VCS runs only get summary_basic.txt.
# export PATH=/usr/bin:$PATH

// Short version of a Vivado-generated 7-series programming SVF.
// Same command sequence as nexys_a7_01.svf, with a tiny CFG_IN payload,
// so that it can be simulated end to end against sim/models/tap_model.sv.
TRST OFF;
ENDIR IDLE;
ENDDR IDLE;
STATE RESET;
STATE IDLE;
FREQUENCY 1.00E+07 HZ;
HIR 0 ;
TIR 0 ;
HDR 0 ;
TDR 0 ;
// config/idcode
SIR 6 TDI (09) ;
SDR 32 TDI (00000000) TDO (03631093) MASK (0fffffff) ;
// config/jprog
STATE RESET;
STATE IDLE;
SIR 6 TDI (0b) ;
SIR 6 TDI (14) ;
RUNTEST 2E-5 SEC;
// config/jprog/poll
RUNTEST 100 TCK;
SIR 6 TDI (14) TDO (11) MASK (31) ;
// config/slr
SIR 6 TDI (05) ;
SDR 200 TDI (aa995566000000000000000000000004ffffffffdeadbeef01) ;
// config/start
STATE IDLE;
RUNTEST 200 TCK;
SIR 6 TDI (0c) ;
STATE IDLE;
RUNTEST 100 TCK;
SIR 6 TDI (09) TDO (31) MASK (11) ;
// config/status
STATE RESET;
RUNTEST 5 TCK;
SIR 6 TDI (05) ;
SDR 160 TDI (0000000400000004800700140000000466aa9955) ;
SIR 6 TDI (04) ;
SDR 32 TDI (00000000) TDO (3f5e0d40) MASK (08000000) ;
STATE RESET;
RUNTEST 5 TCK;
